# Copy to backend/.env for local development. Never commit the real .env.

# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
FLASK_ENV=development
DEBUG=True
PORT=5000

# Any strong random strings (required when FLASK_ENV=production)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# PostgreSQL: either DATABASE_URL ...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_manager
# ... or the individual variables (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=invoice_manager
DB_SSLMODE=prefer

# Frontend origin(s). http://localhost:5173 is allowed automatically outside production.
FRONTEND_URL=
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# AI extraction (Google Gemini). OCR falls back to local parsing if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# Windows only: full path to tesseract.exe if not auto-detected
TESSERACT_CMD=

# File storage: local | s3 | gcs
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
# S3 (STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# GCS (STORAGE_BACKEND=gcs)
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── PRODUCTION (Render dashboard → Environment) ─────────────────────────────
# FLASK_ENV=production
# DEBUG=False
# SECRET_KEY=<long random string>
# JWT_SECRET_KEY=<different long random string>
# DATABASE_URL=<Railway DATABASE_PUBLIC_URL>
# DB_SSLMODE=require
# FRONTEND_URL=https://your-project.vercel.app
# CORS_ORIGIN_REGEX=^https://your-project-[a-z0-9-]+\.vercel\.app$   (optional, preview deploys)
# GEMINI_API_KEY=<your key>
# GEMINI_MODEL=gemini-2.5-flash
# RUN_MIGRATIONS=true
# PORT is set by Render automatically — do not set it.
