# Copy to backend/.env for local development. Never commit the real .env.

# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
FLASK_ENV=development
DEBUG=True
PORT=5000

# Any strong random strings (required when FLASK_ENV=production)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# PostgreSQL: either DATABASE_URL ...
DATABASE_URL=postgresql://postgres.mhlmptbervxglbyadtea:DemoExpenza825@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

# Frontend origin(s). http://localhost:5173 is allowed automatically outside production.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# AI extraction provider: groq | gemini (defaults to whichever key is set).
# OCR falls back to local parsing if no key is set.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Google Gemini (free key: aistudio.google.com/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=45

# Windows only: full path to tesseract.exe if not auto-detected
TESSERACT_CMD=

# File storage: local | s3 | gcs
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
# S3 (STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# GCS (STORAGE_BACKEND=gcs)
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── PRODUCTION (Render dashboard → Environment) ─────────────────────────────
# FLASK_ENV=production
# DEBUG=False
# SECRET_KEY=<long random string>
# JWT_SECRET_KEY=<different long random string>
#
# Supabase PostgreSQL:
# Go to your Supabase project -> Project Settings -> Database -> Connection string -> URI
# Recommended mode: Session pooler or Direct connection (sslmode=require)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSLMODE=require
#
# FRONTEND_URL=https://your-project.vercel.app
# CORS_ORIGIN_REGEX=^https://your-project-[a-z0-9-]+\.vercel\.app$   (optional, preview deploys)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=<your key>          (or GROQ_API_KEY=<your key> with AI_PROVIDER=groq)
# GEMINI_MODEL=gemini-3.5-flash
# RUN_MIGRATIONS=true
# PORT is set by Render automatically — do not set it.
