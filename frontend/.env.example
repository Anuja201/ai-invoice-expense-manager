# Copy to frontend/.env.local for local overrides. Vite only exposes VITE_* vars.

# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
# Leave empty: requests go to /api and the Vite dev server proxies them to
# VITE_DEV_PROXY_TARGET (default http://localhost:5000).
VITE_API_URL=
VITE_DEV_PROXY_TARGET=http://localhost:5000

# ─── PRODUCTION (Vercel → Project Settings → Environment Variables) ──────────
# Render backend URL. "/api" is appended automatically if missing.
# VITE_API_URL=https://your-backend.onrender.com
